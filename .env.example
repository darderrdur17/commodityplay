# ─── Database ────────────────────────────────────────────────────────
# Local (Homebrew Postgres):
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/commodityplaybook?schema=public"

# Neon production (Vercel) — use POOLED url for DATABASE_URL, DIRECT for migrations:
# DATABASE_URL="postgresql://...@ep-xxx-pooler....neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://...@ep-xxx....neon.tech/neondb?sslmode=require"
#
# One-time setup against Neon:
# DATABASE_URL_UNPOOLED="..." ./scripts/setup-neon-db.sh

# Bearer secret for POST /api/setup-db — the one-time repair endpoint that
# applies the bundled schema DDL and seeds the demo catalogue.
# FAILS CLOSED: unset means the endpoint returns 503.
# Generate with: openssl rand -hex 32
# The app also reconciles its own schema automatically on first use (see
# src/lib/db-schema-migrations.ts), so this is only needed for a manual repair.
SETUP_SECRET=""

# ─── Sole administrator allowlist ─────────────────────────────────────
# Comma-separated list of email addresses that may reach /admin, /api/admin
# and /demo. This is the ONLY thing that grants admin — the User.role column
# is ignored. Comparisons are case-insensitive and whitespace is trimmed.
#
# FAILS CLOSED: if this is unset in production the allowlist is empty and
# nobody gets admin access (every admin route returns 404/403). Outside
# production an unset value falls back to frances@commodityplay.ai.
ADMIN_EMAILS="frances@commodityplay.ai"

# ─── NextAuth.js (Auth.js) ────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Your production URL (no trailing slash)
NEXTAUTH_URL="https://your-domain.com"

# ─── Google OAuth (optional) ─────────────────────────────────────────
# Leave empty to hide "Continue with Google". Members can set a password via /forgot-password.
# Get from: console.cloud.google.com → APIs → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Stripe ─────────────────────────────────────────────────────────
# Checkout stays closed until NEXT_PUBLIC_PAYMENTS_ENABLED=true (after paid files are ready).
NEXT_PUBLIC_PAYMENTS_ENABLED="false"

# Get from: dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY="sk_live_..."
# NOT READ BY THE CODE. Checkout is created server-side via Stripe Checkout
# Sessions, so no publishable key is needed anywhere in the app or the mobile
# client. Kept commented out only so nobody wonders where it went.
# STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ─── Stripe Prices (all four are RECURRING monthly, USD) ────────────
# Create in Stripe: Products → Add Product → recurring, interval = month
# Career Pro    USD 19.00 / month
# Career Elite  USD 39.00 / month
# Sales Pro     USD 39.00 / month
# Sales Elite   USD 59.00 / month
STRIPE_PRICE_CAREER_PRO="price_..."
STRIPE_PRICE_CAREER_ELITE="price_..."
STRIPE_PRICE_SALES_PRO="price_..."
STRIPE_PRICE_SALES_ELITE="price_..."

# Yearly recurring prices — used when the member picks 12-month term + billed annually
STRIPE_PRICE_CAREER_PRO_ANNUAL="..."
STRIPE_PRICE_CAREER_ELITE_ANNUAL="..."
STRIPE_PRICE_SALES_PRO_ANNUAL="..."
STRIPE_PRICE_SALES_ELITE_ANNUAL="..."

# ─── Stripe Coupons (amount_off, in cents — exactly 1/7 of the monthly base) ─
# Create in Stripe: Products → Coupons. duration is a DASHBOARD decision, not a
# code one — the checkout route never reads it.
#   "perks continue on renewal"      → duration = forever
#   "perk ends after the first term" → duration = repeating,
#                                      duration_in_months = accessMonths = 14
#
# ⚠️ duration_in_months is accessMonths (14), NOT paidMonths (12). This is
# counter-intuitive, it has already been got wrong once, and getting it wrong
# overcharges members — so here is the arithmetic.
#
# "12 + 2 free" means the member hands over 12 months' money and gets 14 months of
# access. The coupon takes base/7 off EVERY instalment, so the discounted rate is
# 6/7 of base. monthlyRateUsd() in src/data/pricing-shared.ts derives that same 6/7
# from paidMonths/accessMonths = 12/14. The discounted rate therefore has to run for
# the whole 14-month access period:
#
#   duration 14 → 14 x 6/7 base = 12 x base                 ✅ the promise holds
#                 ($228.06 vs $228 on Career Pro — 6c of rounding)
#   duration 12 → 12 x 6/7 base, then the last 2 months at FULL base
#                 = $233.48 on Career Pro                  ❌ overcharges by $5.48
#                 (up to $16.84 over on Sales Elite)
#
# Corroboration: the retired 6-month term used duration 7 — its accessMonths for
# "6 + 1 free" — not 6. The convention is accessMonths in both cases.
#
# One coupon per tier, keyed by the remaining long term (12). Kept term-suffixed so a
# deeper 12-month discount later stays a Dashboard edit, not a PR.
STRIPE_COUPON_CAREER_PRO_TERM12="..."     # amount_off 271  → USD 16.29 / month
STRIPE_COUPON_CAREER_ELITE_TERM12="..."   # amount_off 557  → USD 33.43 / month
STRIPE_COUPON_SALES_PRO_TERM12="..."      # amount_off 557  → USD 33.43 / month
STRIPE_COUPON_SALES_ELITE_TERM12="..."    # amount_off 843  → USD 50.57 / month

# Get from: Stripe Dashboard → Developers → Webhooks → Endpoint
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: Stripe Dashboard → Settings → Billing → Customer portal → Configuration ID
# Enables branded portal with invoice history, payment method update, cancellation
STRIPE_BILLING_PORTAL_CONFIGURATION_ID="bpc_..."

# ─── Renewal reminder (NOT an env var) ───────────────────────────────
# The "reminder 7 days before renewal" promise is fulfilled by Stripe itself.
# Deliberately NOT implemented in code: a second in-app reminder would email the
# same member twice for the same renewal, and Stripe's copy already carries the
# update-payment-method link.
#
#   Settings → Billing → Subscriptions and emails
#     → Email notifications and customer management
#       • "Send emails about upcoming renewals"                 ← the renewal reminder
#       • "Send a reminder email 7 days before a free trial
#          ends"                                                 ← covers the annual 60-day trial
#
# WHERE THE DAY COUNT LIVES — not on that page. The lead time is configured under
#   Settings → Billing → Subscriptions and emails
#     → Prevent failed payments → Upcoming renewal events
# Set it to 7 to match what members were told.
#
# Two things Stripe requires for this to fire:
#   • collection_method must be "charge_automatically" — true for every
#     subscription Checkout creates for us, so no action needed.
#   • "Subscription Management" must be enabled. Stripe's own docs say
#     manage-subscription links in billing emails are needed to avoid FTC /
#     California compliance risk.

# ─── Resend (email) ──────────────────────────────────────────────────
# Get from: resend.com → API Keys
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="hello@commodityplay.ai"

# ─── Rate limiting (optional) ────────────────────────────────────────
# Upstash Redis REST. When unset, limits fall back to an in-process Map
# (fine locally; not durable across Vercel instances).
# UPSTASH_REDIS_REST_URL="https://...upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""

# ─── App URL ─────────────────────────────────────────────────────────
# Used for absolute links in emails and redirects. Must be the canonical host.
# Whatever is set here is the hostname members see in every email link — it is
# currently still the deprecated commodity-playbook-app.vercel.app, which
# redirects correctly but shows the wrong brand on every reminder and receipt.
NEXT_PUBLIC_APP_URL="https://www.commodityplay.ai"

# Canonical origin for <meta> tags, Open Graph and canonical links. Falls back
# to the built-in brand URL when unset. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.commodityplay.ai"

# NOT READ BY THE CODE. The sales landing "See demo" button that consumed this
# was removed, and nothing references it any more. Safe to delete from Vercel.
# NEXT_PUBLIC_SALES_DEMO_URL="mailto:hello@commodityplay.com?subject=Sales%20demo%20request"

# ─── Email (Resend) ──────────────────────────────────────────────────
# Mentor pool receives new questions + admin reminders
MENTOR_NOTIFY_EMAIL="elite.mentor@demo.com"

# Extra recipients for operator lead emails (newsletter, signup, mentor apply,
# contact, Pro/Elite upgrade). Comma-separated. Frances is the intended inbox.
ADMIN_NOTIFY_EMAIL="frances@commodityplay.ai"

# Set to "true" to write outgoing demo emails into the DemoEmailLog table
# instead of actually sending them. Local/dev aid — leave unset in production.
DEMO_EMAIL_LOG=""

{
  "expo": {
    "name": "CommodityPlay.",
    "slug": "commodity-playbook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "commodityplaybook",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0830a0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.commodityplaybook.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0830a0"
      },
      "package": "com.commodityplaybook.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://commodity-playbook-app.vercel.app"
    }
  }
}

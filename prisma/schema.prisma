// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth.js required models ──────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  // Every sign-in reads accounts by user; without this it is a sequential scan.
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Core User model ──────────────────────────────────────────────────
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  company        String?
  profession     String?
  country        String?

  // Business logic fields
  role           Role      @default(USER)
  tier           Tier      @default(STARTER)
  track          Track     @default(CAREER)
  persona        Persona?
  resumePersonaDone Boolean @default(false)
  onboardingDone Boolean   @default(false)
  /// Bumping this invalidates every mobile JWT already issued to this user.
  /// Needed because a bare 7-day JWT cannot otherwise be revoked server-side.
  tokenVersion   Int       @default(0)
  /// True for mentor-identity demo/seed accounts — excluded from the Customers tab (see Mentors tab instead).
  isMentor       Boolean   @default(false)
  /// Links a mentor login account to an anonymous Mentor Connect profile id (e.g. PT-01).
  mentorProfileId String?
  /// Set when an admin revokes a mentor's access — on profile delete, or via the
  /// explicit "Revoke access" action. `isMentor` remains the authority; this records
  /// *why* a mentor account is dormant so a restore can re-grant without guessing.
  /// Null means "never revoked".
  mentorRevokedAt DateTime?

  // Consent (PR3)
  /// Member opted in to the Email Digest / onboarding & marketing emails.
  marketingConsent   Boolean   @default(false)
  /// When marketing consent was last set (audit / compliance).
  marketingConsentAt DateTime?
  /// When the member accepted the Terms of Service + Privacy Policy.
  termsAcceptedAt    DateTime?

  // Stripe billing
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  stripeStatus           String?   @default("inactive")

  // Engagement
  mentorCredits   Int @default(0)
  resumeCredits   Int @default(0)
  jobWaitlist     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  progress           ChapterProgress[]
  mentorQuestions    MentorQuestion[]
  quizResults        QuizResult[]
  knowledgeTestResults KnowledgeTestResult[]
  jobWaitlistEntry   JobWaitlistEntry?
  contentUpdates     ContentModule[]  @relation("ContentUpdates")
  contentRevisions   ContentModuleRevision[] @relation("ContentRevisionUpdates")
  assetUploads       ContentAsset[]   @relation("AssetUploads")
  talkingPoints      TalkingPoint[]
  trackedAccounts    TrackedAccount[]
  accountBookmarks   AccountBookmark[]
  jobChatThreads     JobChatThread[]
  marketNudgeStatuses UserMarketNudgeStatus[]
  /// A member may redeem AT MOST ONE referral code, ever. The uniqueness lives on
  /// `ReferralRedemption.userId` (see that model) — this is only the back-relation.
  referralRedemption ReferralRedemption?

  @@index([email])
  @@index([stripeCustomerId])
  @@unique([mentorProfileId])
}

// ── Enums ────────────────────────────────────────────────────────────
enum Role {
  USER
  ADMIN
}

enum PrepCategory {
  MARKET_MECHANICS
  CURRENT_EVENT
  RISK_PRICING
  LOGISTICS
  OTHER
}

enum Tier {
  STARTER
  PRO
  ELITE
}

enum Track {
  CAREER
  SALES
}

enum Persona {
  FRESH_GRAD
  CAREER_SWITCHER
  INSIDER
  ANALYST_TRADER
  VENDOR
}

enum AccountStatus {
  ACTIVE_DISCUSSION
  FIRST_CONTACT
  STALLED
  RESEARCHING
}

enum BookmarkSource {
  PREP_LIBRARY
  MARKET_NUDGE
}

// ── Content Progress ─────────────────────────────────────────────────
model ChapterProgress {
  id         String   @id @default(cuid())
  userId     String
  chapterId  String   // "a" | "b" | "c" | "d" | "e"
  completed  Boolean  @default(false)
  progress   Int      @default(0) // 0-100
  completedAt DateTime?
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

// ── Mentor Connect ───────────────────────────────────────────────────
model MentorQuestion {
  id         String   @id @default(cuid())
  userId     String
  segment    String   // "physical-trading" | "finance" | "analytics" | "operations" | "sales"
  question   String   @db.Text
  answer     String?  @db.Text
  isAnswered Boolean  @default(false)
  /// Member consent for desk-channel publication. Previously mapped onto a
  /// column literally named `isPublic`, which sat confusingly beside
  /// `mentorShareOptIn` and let a private question be published by mistake.
  memberShareOptIn Boolean @default(false)
  mentorShareOptIn Boolean @default(false)
  /// none | published | rejected — queue = both consents + answered + none
  deskChannelStatus String @default("none")
  deskChannelQaId   String?
  createdAt  DateTime @default(now())
  answeredAt DateTime?
  answeredByEmail      String?
  mentorReminderSentAt DateTime?
  menteeNotifiedAt     DateTime?
  /// Anonymous Mentor Connect profile id the member addressed (e.g. "PT-01").
  /// Mentor inboxes filter on this. Null means the question predates per-mentor
  /// targeting and is therefore hidden from mentors (admins still see it).
  mentorProfileId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mentorProfileId])
  @@index([isAnswered, createdAt])
}

// ── Persona Quiz Results ─────────────────────────────────────────────
model QuizResult {
  id        String   @id @default(cuid())
  userId    String
  persona   Persona
  scores    Json     // { fresh_grad: 20, career_switcher: 45, ... }
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Knowledge Test ───────────────────────────────────────────────────
model KnowledgeTestResult {
  id          String   @id @default(cuid())
  userId      String
  score       Int
  totalQ      Int      @default(20)
  gapAreas    Json     // string[]
  completedAt DateTime @default(now())

  // Previously this model had no relation at all, so deleting a user left their
  // quiz rows behind forever — a GDPR erasure gap. Cascade closes it.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
}

// ── Job Waitlist ─────────────────────────────────────────────────────
model JobWaitlistEntry {
  id        String   @id @default(cuid())
  userId    String?  @unique
  email     String   @unique
  name      String?
  track     Track    @default(CAREER)
  gdprOpt   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ── CMS: tier-gated publishable content ─────────────────────────────
model ContentModule {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?
  requiredTier Tier     @default(STARTER)
  payload      Json
  published    Boolean  @default(true)
  version      Int      @default(1)
  updatedById  String?
  updatedBy    User?    @relation("ContentUpdates", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([requiredTier])
}

model ContentModuleRevision {
  id           String   @id @default(cuid())
  moduleSlug   String
  version      Int
  payload      Json
  requiredTier Tier
  published    Boolean
  updatedById  String?
  updatedBy    User?    @relation("ContentRevisionUpdates", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@unique([moduleSlug, version])
  @@index([moduleSlug, version])
}

model ContentAsset {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  moduleSlug   String?
  assetKey     String?  @unique
  requiredTier Tier     @default(PRO)
  label        String?
  uploadedById String?
  uploadedBy   User?    @relation("AssetUploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([moduleSlug])
}

// ── Email Subscriber (for Weekly Digest) ────────────────────────────
model EmailSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  subscribed  Boolean  @default(true)
  source      String?  // "starter-signup" | "waitlist" | "manual"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Contact form submissions ─────────────────────────────────────────
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

// ── Prep Library ─────────────────────────────────────────────────────
model TalkingPoint {
  id         String      @id @default(uuid())
  userId     String
  track      Track
  createdAt  DateTime    @default(now())
  title      String
  category   PrepCategory
  keyPoints  String[]
  source     String?
  prepStatus String      @default("Learning it")
  usedInNote String?     @db.Text
  canUseFor  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, track])
}

// ── Account Intelligence ─────────────────────────────────────────────
model TrackedAccount {
  id        String        @id @default(uuid())
  userId    String
  name      String
  deskType  String
  status    AccountStatus
  notes     String?       @db.Text
  lastTouch String?
  nextStep  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks AccountBookmark[]

  @@index([userId])
}

model AccountBookmark {
  id          String         @id @default(uuid())
  userId      String
  accountId   String
  sourceType  BookmarkSource
  sourceId    String
  sourceTitle String
  createdAt   DateTime       @default(now())

  account TrackedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId, sourceType, sourceId])
  @@index([userId])
  @@index([accountId])
}

// ── Job Board Live Chat ──────────────────────────────────────────────
model JobChatThread {
  id                 String   @id @default(cuid())
  userId             String
  jobId              String
  jobTitle           String
  company            String
  hirerEmail         String
  hirerName          String?
  hirerToken         String   @unique @default(cuid())
  messages           Json     @default("[]")
  exchangeCount      Int      @default(0)
  interviewOffered   Boolean  @default(false)
  interviewOfferedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([hirerToken])
  @@index([jobId])
}

// ── Demo email log (Mentor Connect notifications preview) ───────────
model DemoEmailLog {
  id        String   @id @default(cuid())
  kind      String   // mentee_answer | mentor_reminder | new_question
  to        String
  subject   String
  bodyText  String   @db.Text
  bodyHtml  String   @db.Text
  delivered Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ── Admin audit trail ───────────────────────────────────────────────
// One row per administrator mutation. Written through
// `recordAdminAudit()` in src/lib/admin-access.ts.
model AdminAuditLog {
  id           String   @id @default(cuid())
  actorEmail   String
  action       String
  targetUserId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail])
  @@index([targetUserId])
}

// ── Member personal status on Sales Market Nudges items ─────────────
model UserMarketNudgeStatus {
  id        String   @id @default(cuid())
  userId    String
  sourceId  String
  kind      String   // WEEKLY_NUDGE | INTELLIGENCE_BRIEF
  status    String   @default("ACTIVE") // ACTIVE | EXPIRED | ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, sourceId])
  @@index([userId])
}

// ── Referral codes ───────────────────────────────────────────────────
// `status` is a String rather than an enum, mirroring `User.stripeStatus`: the
// project has no `prisma/migrations/` directory, so every schema change also has
// to be written by hand as idempotent SQL in `src/lib/db-schema-migrations.ts`.
// A plain TEXT column keeps that SQL trivially re-runnable, whereas a new enum
// would need its own CREATE TYPE guard.
//
// ⚠️ The reward is NOT decided yet. `rewardKind` / `rewardValue` record what an
// administrator intended so the decision can be honoured later; the discount that
// is ACTUALLY applied comes from the Stripe coupon named by
// `STRIPE_REFERRAL_COUPON_ID` (see `src/lib/referral-reward.ts`). This app never
// creates or edits anything in Stripe — the owner creates coupons in the
// Dashboard herself.
model ReferralCode {
  id          String    @id @default(cuid())
  /// Stored UPPERCASE and normalised on both write and lookup — see
  /// `normalizeReferralCode()` in `src/lib/referral-codes.ts`.
  code        String    @unique
  /// Administrator's internal note. NEVER shown to members.
  label       String?
  rewardKind  String    @default("percent_off")
  /// Null = the reward has not been decided yet.
  rewardValue Int?
  expiresAt   DateTime?
  disabled    Boolean   @default(false)
  /// Plain scalar, deliberately not a relation: the creator is audit metadata,
  /// never an access decision, and a relation would add a User back-relation plus
  /// a foreign key that the bundled SQL would then have to maintain.
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  redemption ReferralRedemption?

  @@index([createdAt])
}

/// One row per redemption attempt. Two unique constraints carry the whole
/// single-use rule:
///   * `referralCodeId` unique -> a code can be claimed exactly once
///   * `userId` unique         -> a member can claim exactly once
///
/// They are enforced BY THE DATABASE on purpose. An application-level
/// `count()` check is a read-then-write race: two concurrent checkouts both read
/// "not redeemed yet" and both proceed. A second INSERT instead fails atomically
/// with Prisma `P2002`, which the checkout route turns into a 409.
model ReferralRedemption {
  id              String    @id @default(cuid())
  referralCodeId  String
  userId          String
  /// RESERVED (checkout session created, not yet paid) | CONFIRMED (paid)
  status          String    @default("RESERVED")
  stripeSessionId String?
  reservedAt      DateTime  @default(now())
  confirmedAt     DateTime?

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([referralCodeId])
  @@unique([userId])
  @@index([status])
}

/// Shared fixed-window counter for rate limiting.
///
/// Exists because Upstash Redis is not configured in production, and the
/// in-process Map fallback multiplies every limit by the number of warm lambdas.
/// Postgres is already shared by every lambda, so one atomic upsert per check
/// gives a genuinely distributed limit with no new credential.
///
/// Not a domain table: rows are transient and swept an hour after expiry. Written
/// by raw SQL in `src/lib/rate-limit.ts` (see `PG_WINDOW_SQL`) because the
/// increment-and-reset must happen in a single statement to be race-free.
model RateLimitCounter {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
